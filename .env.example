# Demo gate: callers must supply this passcode to receive a Telnyx login token.
DEMO_PASSCODE=change-me-in-production

# Telnyx API key used by the server to mint telephony credential tokens.
# Get this from https://portal.telnyx.com/ ; never commit the real value.
TELNYX_API_KEY=

# Telnyx SIP Connection / telephony credential ID used for WebRTC login tokens.
TELNYX_CONNECTION_ID=
TELNYX_TELEPHONY_CREDENTIAL_ID=

# Telnyx phone number assigned to the demo agent (E.164 format, e.g. +15551234567).
TELNYX_PHONE_NUMBER=

# Optional verified outbound destination for the demo proof (E.164 format).
DEMO_VERIFIED_DESTINATION=

# Server port; defaults to 3001.
PORT=3001

# Optional: local Vite dev origin for CORS. Defaults to http://localhost:5173.
VITE_DEV_ORIGIN=http://localhost:5173
